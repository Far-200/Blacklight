# Base path every request from the typed API client is prefixed with.
# In development this is proxied by Vite to http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_BASE_URL=/api

# When true, every service that has no backend endpoint yet resolves from
# src/mocks/ instead of issuing a network request. Set to false only when the
# FastAPI orchestrator is running locally.
VITE_USE_MOCKS=true
